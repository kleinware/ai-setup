{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "spec-manager repository configuration (spec/.config.yaml)",
  "type": "object",
  "properties": {
    "status": {
      "oneOf": [
        { "const": false },
        { "const": "false" },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "description": { "type": "string", "minLength": 1 }
            },
            "required": ["name", "description"],
            "additionalProperties": false
          }
        }
      ]
    },
    "taxonomy": {
      "type": "object",
      "properties": {
        "layers": {
          "oneOf": [
            { "const": false },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
            }
          ]
        },
        "structure": { "type": "object" }
      },
      "required": ["layers"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
