{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "host-llama-server"
  ],
  "model": "host-llama-server/coding",
  "subagent_depth": 2,
  "agent": {
    "build": {
      "permission": { 
        "doom_loop": "deny",
        "external_directory":"allow",
        "read":"allow",
        "question": "deny",
        "todowrite": "deny",
        }
     },
     "plan": {
      "permission": {
        "doom_loop": "deny",
        "read":"allow",
        "external_directory":"allow",
        "edit":"allow"
      }
     },

     "general": {
      "permission": {
        "doom_loop": "deny",
        "external_directory":"allow",
        "read":"allow",
        "task":"allow"
      }
     },
     "explore": {
      "permission": {
        "doom_loop": "deny",
        "external_directory":"allow",
        "read":"allow",

      }
     }
  },
  "provider": {
    "host-llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://host.docker.internal:8778/v1",
        "includeUsage": true,
        "timeout": false
      },
      "models": {
        "coding": {
          "limit": { "context": 130000, "output": 32768 },
          "cost": { "input": 0.2, "output": 1.20, "cache_read": 0.02, "cache_write": 0 },
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
