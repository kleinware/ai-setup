{
  "$schema": "https://opencode.ai/config.json",
  "worktree": {
    "directory": "../worktrees"
  },
  "provider": {
    "host-llama-server": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://host.docker.internal:8778/v1",
        "includeUsage": true,
        "timeout": false
      },
      "models": {
        "qwen3.8-27B-Coding-Multi-ISTA-GSQ-RCO-IQ3_XXS": {
          "limit": { "context": 130000, "output": 32768 },
          "cost": { "input": 0.2, "output": 1.20, "cache_read": 0.02, "cache_write": 0 },
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}
