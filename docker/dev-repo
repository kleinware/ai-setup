#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat >&2 <<'EOF'
Usage: dev-repo <command> [args]

Commands:
  up           Build and start the project container
  up --all     Recreate all running dev project containers
  ls           List running dev project containers
  down         Tear down the project container and its volumes

up must be run from the git root of a worktree whose folder is named 'main'.
The project name is the name of the folder containing 'main'.

Host ports are assigned automatically and encoded in the compose project name:
dev-<project>-<range-start> (for example dev-my-project-2240). The range
start is the first free range at or above 2200 in increments of 10, checked
in the order 2200, 2210, 2220, ...; ranges in use are read from the names of
existing dev containers (running or not). The SSH port is range start + 2
(ending in 2, mapped to container port 22) and the web port is range start + 8
(ending in 8, mapped to container port 8080). The other endings in each group
of ten are reserved for future mappings. An existing container is recreated
with its current ports.
EOF
    exit 1
}

resolve_script_dir() {
    # Resolve the script directory, following symlinks so this works when
    # the script is invoked through a symlink (e.g. ~/bin/dev-repo ->
    # docker/dev-repo).
    local script_source="${BASH_SOURCE[0]}"
    local script_link_dir
    while [[ -L "$script_source" ]]; do
        script_link_dir="$(cd -- "$(dirname -- "$script_source")" && pwd -P)"
        script_source="$(readlink -- "$script_source")"
        if [[ "$script_source" != /* ]]; then
            script_source="$script_link_dir/$script_source"
        fi
    done
    cd -- "$(dirname -- "$script_source")" && pwd -P
}

require_host_files() {
    export SSH_PUBLIC_KEY="${SSH_PUBLIC_KEY:-$HOME/.ssh/herdr-container.pub}"
    export GITCONFIG="${GITCONFIG:-$HOME/.gitconfig}"
    export HOST_UID="$(id -u)"
    export HOST_GID="$(id -g)"

    if [[ ! -f "$SSH_PUBLIC_KEY" ]]; then
        echo "SSH public key not found: $SSH_PUBLIC_KEY" >&2
        exit 1
    fi

    if [[ ! -f "$GITCONFIG" ]]; then
        echo "gitconfig not found: $GITCONFIG" >&2
        exit 1
    fi
}

# All dev- compose projects and their container IDs, running or not, as
# "<project>\t<id>" lines.
dev_projects() {
    docker ps -a --format '{{json .}}' | jq -sr '
        [ .[]
          | (.Labels | split(",") |
              map(select(startswith("com.docker.compose.project=")) | split("=") | .[1]) |
              first) as $proj
          | select($proj != null and ($proj | startswith("dev-")))
          | [ $proj, .ID ]
        ] | map(@tsv) | join("\n")'
}

# Port range starts (encoded in container names) already in use by dev-
# containers, running or not, one per line.
used_port_ranges() {
    local name
    local rows
    rows="$(dev_projects)"
    while IFS=$'\t' read -r name _; do
        if [[ "$name" =~ ^dev-.+-([0-9]{4,})$ ]]; then
            echo "${BASH_REMATCH[1]}"
        fi
    done <<<"$rows" | sort -u
}

# Compose project name and container ID of an existing container for this
# project, if any: "dev-<project>-<range-start>". Prints "<name> <id>".
existing_project() {
    local project="$1"
    local prefix="dev-${project}"
    local rows name cid
    rows="$(dev_projects)"
    while IFS=$'\t' read -r name cid; do
        if [[ "$name" =~ ^${prefix}-([0-9]{4,})$ ]]; then
            echo "$name $cid"
            return 0
        fi
    done <<<"$rows"
    return 1
}

# Host ports of a container: "<ssh port> <web port>", the web port empty when
# unmapped.
container_ports() {
    docker inspect --format '{{json .HostConfig.PortBindings}}' "$1" | jq -r '
        (.["22/tcp"] | if type == "array" and length > 0 then .[0].HostPort else "" end) as $ssh
        | (.["8080/tcp"] | if type == "array" and length > 0 then .[0].HostPort else "" end) as $web
        | "\($ssh) \($web)"'
}

# Add or update the host's entry in ~/.ssh/config. Sets SSH_CONFIG_ACTION to
# 'Added' or 'Updated'.
update_ssh_config() {
    local host="$1" port="$2"
    local ssh_dir="$HOME/.ssh"
    local config_file="$ssh_dir/config"
    local block tmp
    block="$(printf 'Host %s\n    HostName 127.0.0.1\n    Port %s\n    User agent\n    IdentityFile %s\n    IdentitiesOnly yes' \
        "$host" "$port" "${SSH_PUBLIC_KEY%.pub}")"

    mkdir -m 700 -p "$ssh_dir"

    if [[ -f "$config_file" ]] && grep -qxF "Host $host" "$config_file"; then
        tmp="$(mktemp)"
        block="$block" awk -v host="$host" '
            BEGIN { skipping = 0; block = ENVIRON["block"] }
            {
                if (skipping) {
                    if ($0 ~ /^Host /) { skipping = 0; print block; print "" }
                    else next
                }
                if ($0 == "Host " host) { skipping = 1; next }
                print
            }
            END { if (skipping) print block }
        ' "$config_file" > "$tmp"
        cat "$tmp" > "$config_file"
        rm -f "$tmp"
        SSH_CONFIG_ACTION="Updated"
    else
        if [[ -f "$config_file" ]] && [[ -s "$config_file" ]]; then
            printf '\n%s\n' "$block" >> "$config_file"
        else
            printf '%s\n' "$block" >> "$config_file"
        fi
        SSH_CONFIG_ACTION="Added"
    fi
}

# Register the container as a herdr machine when herdr is installed, or
# print the command to run. Prints its summary bullet lines.
register_herdr_machine() {
    local host="$1" label="$2"

    if ! command -v herdr >/dev/null 2>&1; then
        echo "- Register with herdr (nested herdr sessions are not allowed):"
        echo "    herdr machine add ${host} --label \"${label}\""
        return 0
    fi

    local existing
    existing="$(herdr machine list --json | jq -r --arg host "$host" \
        '[ .[] | select(.target == $host) ] | length' 2>/dev/null)" || existing="0"
    if [[ "$existing" =~ ^[0-9]+$ ]] && (( existing > 0 )); then
        echo "- Machine already registered with herdr"
        return 0
    fi

    # The container's sshd may not be listening yet, so retry a few times.
    local attempt
    for ((attempt = 1; attempt <= 5; attempt++)); do
        if herdr machine add "$host" --label "$label" >/dev/null; then
            echo "- Added machine ${host} to herdr (label ${label})"
            return 0
        fi
        if (( attempt < 5 )); then
            sleep 1
        fi
    done

    echo "Warning: failed to register ${host} with herdr; run it manually:" >&2
    echo "    herdr machine add ${host} --label \"${label}\"" >&2
    echo "- Failed to add machine ${host} to herdr (run the command above manually)"
    return 0
}

# Pick the first free port range at or above 2200, in increments of 10.
# Sets RANGE_START, SSH_PORT (range start + 2), and WEB_PORT (range start + 8).
assign_port_range() {
    local ranges base
    ranges="$(used_port_ranges)"
    for ((base = 2200; base <= 65520; base += 10)); do
        if ! grep -qx "$base" <<<"$ranges"; then
            RANGE_START="$base"
            SSH_PORT=$((base + 2))
            WEB_PORT=$((base + 8))
            return 0
        fi
    done
    echo "No free port range at or above 2200 is available." >&2
    return 1
}

# Recreate every running dev- compose project (as listed by ls), using each
# container's existing host ports and /workspace bind mount source.
up_all() {
    local script_dir
    script_dir="$(resolve_script_dir)"

    require_host_files

    local rows
    rows="$(docker ps --filter status=running --format '{{json .}}' | jq -sr '
        [ .[]
          | (.Labels | split(",") |
              map(select(startswith("com.docker.compose.project=")) | split("=") | .[1]) |
              first) as $proj
          | select($proj != null and ($proj | startswith("dev-")))
          | [ .ID, $proj ]
        ] | map(@tsv) | join("\n")')"

    if [[ -z "$rows" ]]; then
        echo "No running dev project containers."
        return 0
    fi

    local cid proj ports ssh web source
    while IFS=$'\t' read -r cid proj; do
        source="$(docker inspect --format \
            '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' \
            "$cid")"
        if [[ -z "$source" ]]; then
            echo "Skipping $proj: no /workspace bind mount." >&2
            continue
        fi

        ports="$(container_ports "$cid")"
        read -r ssh web <<<"$ports"
        if [[ ! "$ssh" =~ ^[0-9]+$ ]]; then
            echo "Skipping $proj: no SSH port mapping." >&2
            continue
        fi
        [[ "${web:-}" =~ ^[0-9]+$ ]] || web=$((10#$ssh + 6))

        export SSH_PORT="$ssh"
        export WEB_PORT="$web"
        export PROJECT_DIR="$source"

        docker compose \
            -f "${script_dir}/docker-compose.yml" \
            -p "$proj" \
            up -d --force-recreate

        echo "Recreated $proj."
    done <<<"$rows"
}

# Tear down the project's compose stack (container and named volumes) after
# a yes/no confirmation.
down_project() {
    local script_dir
    script_dir="$(resolve_script_dir)"

    # Must be run from the git root, and that folder must be named 'main'.
    local CWD
    CWD="$(pwd -P)"
    if [[ "$(basename -- "$CWD")" != "main" ]]; then
        echo "Must be run from a folder named 'main': $CWD" >&2
        exit 1
    fi
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo "Must be run from a git worktree: $CWD" >&2
        exit 1
    fi
    if [[ "$(git rev-parse --show-toplevel)" != "$CWD" ]]; then
        echo "Must be run from the git root, not a subdirectory: $CWD" >&2
        exit 1
    fi

    local PROJECT_DIR PROJECT
    PROJECT_DIR="$(dirname -- "$CWD")"
    PROJECT="$(basename -- "$PROJECT_DIR")"

    if [[ ! "$PROJECT" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
        echo "Invalid project name: $PROJECT" >&2
        exit 1
    fi

    local EXISTING
    if ! EXISTING="$(existing_project "$PROJECT")"; then
        echo "No container found for project '$PROJECT'."
        return 0
    fi
    local PROJECT_NAME CID
    read -r PROJECT_NAME CID <<<"$EXISTING"

    local WORKSPACE_SOURCE
    WORKSPACE_SOURCE="$(docker inspect --format \
        '{{range .Mounts}}{{if eq .Destination "/workspace"}}{{.Source}}{{end}}{{end}}' \
        "$CID")"

    echo
    echo "This will destroy the container and its volumes:"
    echo
    echo "  Container: ${PROJECT_NAME} (${CID:0:12})"
    echo "    - the opencode session information in the container"
    echo "    - the SSH host key (connection fingerprint) for ${PROJECT_NAME}"
    echo "    - all files in the container that are not under /workspace"
    echo
    if [[ -n "$WORKSPACE_SOURCE" ]]; then
        echo "  /workspace maps to this folder on the host: ${WORKSPACE_SOURCE}"
    fi
    echo
    printf 'Tear down %s? [y/N] ' "$PROJECT_NAME"
    local answer
    read -r answer
    if [[ ! "$answer" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        return 0
    fi

    docker compose \
        -f "${script_dir}/docker-compose.yml" \
        -p "$PROJECT_NAME" \
        down -v --remove-orphans

    echo "Tore down ${PROJECT_NAME} and its volumes."
}

[[ $# -ge 1 ]] || usage
COMMAND="$1"
shift

case "$COMMAND" in
    up)
        if [[ $# -eq 1 && "$1" == "--all" ]]; then
            up_all
        else
            [[ $# -eq 0 ]] || usage

            # Must be run from the git root, and that folder must be named 'main'.
            CWD="$(pwd -P)"
            if [[ "$(basename -- "$CWD")" != "main" ]]; then
                echo "Must be run from a folder named 'main': $CWD" >&2
                exit 1
            fi
            if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
                echo "Must be run from a git worktree: $CWD" >&2
                exit 1
            fi
            if [[ "$(git rev-parse --show-toplevel)" != "$CWD" ]]; then
                echo "Must be run from the git root, not a subdirectory: $CWD" >&2
                exit 1
            fi

            PROJECT_DIR="$(dirname -- "$CWD")"
            PROJECT="$(basename -- "$PROJECT_DIR")"

            # Validate the Compose project name.
            if [[ ! "$PROJECT" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
                echo "Invalid project name: $PROJECT" >&2
                exit 1
            fi

            # Recreate an existing container with its current ports, or pick
            # the first free port range and name the container after it.
            if EXISTING="$(existing_project "$PROJECT")"; then
                read -r PROJECT_NAME _ <<<"$EXISTING"
                RANGE_START="${PROJECT_NAME##*-}"
                UP_ACTION="Recreated"
            else
                assign_port_range
                PROJECT_NAME="dev-${PROJECT}-${RANGE_START}"
                UP_ACTION="Started"
            fi
            SSH_PORT=$((10#$RANGE_START + 2))
            WEB_PORT=$((10#$RANGE_START + 8))
            export SSH_PORT WEB_PORT PROJECT_DIR

            # Create the worktrees directory next to 'main' if it doesn't exist.
            mkdir -p "${PROJECT_DIR}/worktrees"

            SCRIPT_DIR="$(resolve_script_dir)"

            require_host_files

            docker compose \
                -f "${SCRIPT_DIR}/docker-compose.yml" \
                -p "$PROJECT_NAME" \
                up -d --build

            SSH_HOST="$PROJECT_NAME"

            update_ssh_config "$SSH_HOST" "$SSH_PORT"

            echo
            echo "Project '$PROJECT' is running."
            echo
            echo "- ${UP_ACTION} container ${SSH_HOST}"
            echo "- SSH port ${SSH_PORT} -> container port 22"
            echo "- Web port ${WEB_PORT} -> container port 8080 (http://127.0.0.1:${WEB_PORT}/)"
            echo "- ${SSH_CONFIG_ACTION} ~/.ssh/config entry for host ${SSH_HOST}"
            register_herdr_machine "$SSH_HOST" "$PROJECT"
        fi
        ;;

    ls)
        containers="$(docker ps --filter status=running --format '{{json .}}')"

        if [[ -n "$containers" ]]; then
            rows="$(jq -sr '
                [ .[]
                  | (.Labels | split(",") |
                      map(select(startswith("com.docker.compose.project=")) | split("=") | .[1]) |
                      first) as $proj
                  | select($proj != null and ($proj | startswith("dev-")))
                  | (if (.Ports | length) > 0
                     then (.Ports | split(",") | .[0] | capture(":(?<p>[0-9]+)->") | .p)
                     else "-"
                     end) as $port
                  | [ $proj, $port, .Status ]
                ] | map(@tsv) | join("\n")' <<<"$containers")"
        else
            rows=""
        fi

        if [[ -z "$rows" ]]; then
            echo "No running dev project containers."
        else
            printf '%-20s %5s  %s\n' "PROJECT" "PORT" "STATUS"
            while IFS=$'\t' read -r proj port status; do
                printf '%-20s %5s  %s\n' "$proj" "$port" "$status"
            done <<<"$rows"
        fi
        ;;

    down)
        down_project
        ;;

    *)
        echo "Unknown command: $COMMAND" >&2
        usage
        ;;
esac
